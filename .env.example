# Eerste beheerder. Wordt alleen gebruikt om het eerste account aan te maken; daarna beheer je
# gebruikers in het dashboard (Beheer → Gebruikers). Wachtwoord minimaal 10 tekens.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Wachtwoord kwijt? Zet tijdelijk op 1: bij het opstarten wordt ADMIN_USER gereset naar ADMIN_PASSWORD (2FA uit).
RESET_ADMIN_PASSWORD=0

# Netwerk
PORT=8080
HOST=127.0.0.1

# Publieke URL (gebruikt in het installatiecommando voor de agent en in links in meldingen)
PUBLIC_URL=https://monitor.nextbuzz.nl
# Zet op 1 als het dashboard achter nginx/Caddy (HTTPS) draait
TRUST_PROXY=1
SECURE_COOKIE=1

# Opslag: ruwe metingen worden na COMPACT_AFTER_DAYS samengevat tot uurgemiddelden
# en in totaal RETENTION_DAYS bewaard.
DATA_DIR=data
RETENTION_DAYS=365
COMPACT_AFTER_DAYS=7
PROC_SNAPSHOT_INTERVAL=60
PROC_RETENTION_HOURS=72

# Alleen voor Docker (docker-compose.yml + Caddy): domeinnaam voor het HTTPS-certificaat
# en e-mailadres voor Let's Encrypt (waarschuwingen over certificaten).
DOMAIN=monitor.nextbuzz.nl
ACME_EMAIL=
