# Inloggegevens voor het dashboard (verplicht)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Netwerk
PORT=8080
HOST=127.0.0.1

# Publieke URL (wordt gebruikt in het installatiecommando voor de agent)
PUBLIC_URL=https://monitor.nextbuzz.nl
# Zet op 1 als het dashboard achter nginx/Caddy (HTTPS) draait
TRUST_PROXY=1
SECURE_COOKIE=1

# Opslag
DATA_DIR=data
RETENTION_DAYS=30
PROC_SNAPSHOT_INTERVAL=60
PROC_RETENTION_HOURS=72
